<Project>
  <Target
    Name="RejectDirectFluentAssertionsReference"
    BeforeTargets="CollectPackageReferences;Restore"
    Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <_DirectFluentAssertionsReference
        Include="@(PackageReference)"
        Condition="'%(Identity)' == 'FluentAssertions'" />
    </ItemGroup>

    <Error
      Condition="'@(_DirectFluentAssertionsReference)' != ''"
      Text="FluentAssertions is not allowed in test projects. Remove the direct dependency and use AwesomeAssertions instead." />
  </Target>

  <Target
    Name="RejectResolvedFluentAssertionsDependency"
    AfterTargets="Restore"
    BeforeTargets="CoreCompile"
    Condition="'$(IsTestProject)' == 'true' and Exists('$(ProjectAssetsFile)')">
    <ReadLinesFromFile File="$(ProjectAssetsFile)">
      <Output TaskParameter="Lines" ItemName="_ProjectAssetsLines" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_ResolvedFluentAssertionsDependency
        Include="@(_ProjectAssetsLines)"
        Condition="
          $([System.String]::Copy('%(Identity)').Contains('&quot;FluentAssertions/'))
          Or
          $([System.String]::Copy('%(Identity)').Contains('&quot;FluentAssertions&quot;:'))" />
    </ItemGroup>

    <Error
      Condition="'@(_ResolvedFluentAssertionsDependency)' != ''"
      Text="FluentAssertions is not allowed in test projects. Remove the direct or transitive dependency and use AwesomeAssertions instead." />
  </Target>
</Project>
