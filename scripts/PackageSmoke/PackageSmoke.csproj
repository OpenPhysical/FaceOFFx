<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(FaceOffxPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FaceOFFx" Version="$(Version)" />
  </ItemGroup>
</Project>
